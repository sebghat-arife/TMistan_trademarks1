# ──────────────────────────────────────────────────────────────────────────────
# TMistan — environment variables (placeholders only; never commit real values)
# ──────────────────────────────────────────────────────────────────────────────

# ── Web app (public, baked into the browser bundle at BUILD time) ────────────
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx   # or the legacy "anon" JWT

# Optional footer contact details (public)
SITE_CONTACT_EMAIL=
SITE_CONTACT_PHONE=
SITE_CONTACT_ADDRESS=Kabul, Afghanistan
SITE_FACEBOOK_URL=
SITE_TWITTER_URL=
SITE_LINKEDIN_URL=

# ── Runtime (container) ──────────────────────────────────────────────────────
PORT=8080
ENVIRONMENT=production

# ── Importers ONLY (trusted operator machine / CI — NEVER in the web app) ────
# Copy to importers/.env. The service-role key bypasses Row Level Security.
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
# SUPABASE_BUCKET=trademark-images
