# Web app — public settings only. NEVER put the service-role / secret key here.
#
# Production (real Supabase project):
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Local dev stack (PostgreSQL + PostgREST + static image server), instead of the above:
# SUPABASE_URL=/supabase
# SUPABASE_PUBLISHABLE_KEY=<LOCAL_ANON_KEY from scripts/local-stack/keys.env>
# VITE_LOCAL_STORAGE_BASE=/local-storage

# Optional public footer/homepage metadata (not secrets):
# SITE_CONTACT_EMAIL=
# SITE_CONTACT_PHONE=
# SITE_CONTACT_ADDRESS=Kabul, Afghanistan
# SITE_FACEBOOK_URL=
# SITE_TWITTER_URL=
# SITE_LINKEDIN_URL=
# Public website of Masnad Law Firm (defaults to https://www.masnadip.af/; empty = no link):
# SITE_MASNAD_URL=https://www.masnadip.af/
