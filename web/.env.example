# ── Production (Supabase) ────────────────────────────────────────────────
# Public anon key only. NEVER put the service-role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...anon...

# ── Local dev stack (PostgreSQL + PostgREST + static image server) ───────
# VITE_SUPABASE_URL=/supabase
# VITE_SUPABASE_ANON_KEY=<LOCAL_ANON_KEY from scripts/local-stack/keys.env>
# VITE_LOCAL_STORAGE_BASE=/local-storage
